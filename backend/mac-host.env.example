# Copy to the MacDuty (or other Apple Silicon) host — do not commit real secrets.
FAIRPLAY_HOST=mac
DECRYPT_BACKENDS=unfairplay
UNFAIRPLAY_BIN=$HOME/bin/unfairplay
FAIRPLAY_ENROLLMENT_MODEL=$HOME/unfairplay/models/fairplay-enrollment.bin
UNFAIRPLAY_MODEL_DIR=$HOME/unfairplay/models
FAIRPLAY_IPATOOL_BIN=ipatool
