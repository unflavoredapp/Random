# Debian 13 Linux VPS — FastDecrypt / Tetherless with an iPhone Phone Worker.
# Copy to /etc/tetherless/linux-host.env (mode 0600). Never commit real secrets.
#
# How decrypt works (no Mac required):
#   1) This VPS queues App Store links (site / Telegram / Discord / API).
#   2) An iPhone running TetherLess → Settings → Phone Worker claims jobs.
#   3) The phone downloads + FairPlay-decrypts on-device, uploads the clear IPA.
#   4) Keys never leave the phone as a file — only the clear IPA is uploaded.
#
# iPhone setup:
#   • Sign into Media & Purchases / App Store with the Apple ID that owns the apps
#   • Open TetherLess → Account → Settings → FairPlay Decrypt → Decrypt site URL
#     = https://your-vps-host/  (same host this API serves)
#   • Settings → Phone Worker → paste DECRYPT_WORKER_TOKEN below → enable → keep app open
#   • Optional: FairPlay Keys capture sheet to confirm SC_Info readiness

FAIRPLAY_HOST=linux
DECRYPT_BACKENDS=phone
FAIRPLAY_REQUIRE_CREDENTIAL=0

# Shared secret — generate once: openssl rand -hex 24
DECRYPT_WORKER_TOKEN=replace-with-openssl-rand-hex-24

# HTTPS API (mac-https-api.js — filename historical; runs on Linux):
MAC_API_OPEN=1
MAC_API_PORT=8787
MAC_PUBLIC_BASE=https://fastdecrypt.bot
# MAC_WEB_MAX_GB=6

# Cache / drop dirs (created by linux-install.sh):
MAC_TG_DROP_DIR=/var/lib/tetherless/drop
MAC_TG_IPA_CACHE_DIR=/var/lib/tetherless/ipa-cache
MAC_TG_ENC_CACHE_DIR=/var/lib/tetherless/ipa-cache/encrypted
MAC_TG_URL_LOG_DIR=/var/lib/tetherless/url-log
MAC_TG_USER_LOG_DIR=/var/lib/tetherless/user-log
MAC_TG_MIN_FREE_DISK_GB=8
# MAC_TG_WORKERS=4

# Telegram bot (optional — queue feeds the same phone worker):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=FastDecryptAI
# TELEGRAM_BOT_BRAND=FastDecrypt
# TELEGRAM_VIP_CONTACT=YourTelegramUsername
# TELEGRAM_VIP_IDS=
# TELEGRAM_LOCKDOWN=1
# TELEGRAM_ALLOWED_IDS=123456789

# Discord bot (optional):
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_NAME=FastDecrypt
# DISCORD_MESSAGE_CONTENT=1
# DISCORD_UPLOAD_MAX_MB=24
# DISCORD_VIP_IDS=
# DISCORD_ADMIN_IDS=
# DISCORD_FREE_DAILY=5
# DISCORD_VIP_DAILY=100

# Premium Telegram user session (large IPA uploads to users):
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
# TELEGRAM_PREMIUM_UPLOAD=1
# TELEGRAM_UPLOAD_CHANNEL=-100xxxxxxxxxx

# Public site / VIP links:
FASTDECRYPT_SITE_URL=https://fastdecrypt.bot
FASTDECRYPT_PATCH_URL=https://fastdecrypt.bot/
FASTDECRYPT_VIP_URL=https://fastdecrypt.bot/vip

# ---------------------------------------------------------------------------
# Optional: offline CLI decrypt WITHOUT an iPhone (needs a Mac-minted model).
# Uncomment only if you also have fairplay-enrollment.bin from unfairplay setup.
# DECRYPT_BACKENDS=phone,unfairplay
# UNFAIRPLAY_BIN=/usr/local/bin/unfairplay
# FAIRPLAY_ENROLLMENT_MODEL=/var/lib/tetherless/fairplay-enrollment.bin
# UNFAIRPLAY_MODEL_DIR=/var/lib/tetherless/models
# FAIRPLAY_IPATOOL_BIN=/usr/local/bin/ipatool
