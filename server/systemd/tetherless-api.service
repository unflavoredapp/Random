[Unit]
Description=Tetherless / FastDecrypt HTTPS API (Linux VPS + iPhone Phone Worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@INSTALL_USER@
Group=@INSTALL_USER@
WorkingDirectory=@SERVER_DIR@
EnvironmentFile=-@ENV_FILE@
Environment=NODE_ENV=production
ExecStart=/usr/bin/node @SERVER_DIR@/mac-https-api.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
# Clear IPAs can be multi-GB
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
