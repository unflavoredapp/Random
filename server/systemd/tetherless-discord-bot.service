[Unit]
Description=Tetherless / FastDecrypt Discord bot (queues → iPhone Phone Worker)
After=network-online.target tetherless-api.service
Wants=network-online.target

[Service]
Type=simple
User=@INSTALL_USER@
Group=@INSTALL_USER@
WorkingDirectory=@SERVER_DIR@
EnvironmentFile=-@ENV_FILE@
Environment=NODE_ENV=production
ExecStart=/usr/bin/node @SERVER_DIR@/mac-discord-bot.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
