# Copy to the MacDuty (or other Apple Silicon) host — do not commit real secrets.
FAIRPLAY_HOST=mac
DECRYPT_BACKENDS=unfairplay
UNFAIRPLAY_BIN=$HOME/bin/unfairplay
FAIRPLAY_ENROLLMENT_MODEL=$HOME/unfairplay/models/fairplay-enrollment.bin
UNFAIRPLAY_MODEL_DIR=$HOME/unfairplay/models
FAIRPLAY_IPATOOL_BIN=ipatool

# Own Telegram decrypt bot (@BotFather) — optional but recommended on the Mac host.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=YourDecryptBot
# TELEGRAM_ALLOWED_IDS=123456789
#
# Standalone Tetherless bot — WebSSH (no desktop):
#   zsh ~/tetherless/server/mac-ssh.sh start
#   zsh ~/tetherless/server/mac-ssh.sh status
#   zsh ~/tetherless/server/mac-ssh.sh logs
# TestFlight: drop encrypted IPAs in ~/tetherless-drop then: decrypt App.ipa
# MAC_TG_DROP_DIR=$HOME/tetherless-drop
#
# Dedicated Keychain (avoids broken login.keychain password prompts):
# TETHERLESS_KEYCHAIN_PASSWORD=pick-a-strong-pass
# Then once: zsh ~/tetherless/server/mac-keychain-setup.sh && ipatool auth login
#
# Full HTTPS backup API for the iOS app (Decrypt site URL):
# MAC_API_OPEN=1
# MAC_API_PORT=8787
# Double-click Start-Tetherless-API.command → copy trycloudflare.com URL into the app.
#
# Large IPA uploads back to Telegram (Premium does NOT raise Bot API’s ~50 MB cap):
# Option A — Premium user MTProto ≤4 GB (recommended for big apps):
#   python3 -m pip install --user pyrogram tgcrypto
#   python3 ~/tetherless/server/mac-tg-session-setup.py
#   # then in ~/.tetherless-mac.env:
#   TELEGRAM_API_ID=…
#   TELEGRAM_API_HASH=…
#   TELEGRAM_SESSION=…
#   TELEGRAM_PREMIUM_UPLOAD=1
# Option B — Local Bot API ≤2000 MB:
#   TELEGRAM_API_ROOT=http://127.0.0.1:8081
#   TELEGRAM_LOCAL_API=1
#
# Cloud cache (instant re-send): after first decrypt, Telegram file_id is stored under
# ~/tetherless-ipa-cache. Same App Store link later → send by file_id (no UnfairPlay).
# MAC_TG_IPA_CACHE_DIR=$HOME/tetherless-ipa-cache

