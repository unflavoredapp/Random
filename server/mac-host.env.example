# Copy to the MacDuty (or other Apple Silicon) host — do not commit real secrets.
FAIRPLAY_HOST=mac
DECRYPT_BACKENDS=unfairplay
UNFAIRPLAY_BIN=$HOME/bin/unfairplay
FAIRPLAY_ENROLLMENT_MODEL=$HOME/unfairplay/models/fairplay-enrollment.bin
UNFAIRPLAY_MODEL_DIR=$HOME/unfairplay/models
FAIRPLAY_IPATOOL_BIN=ipatool
# FAIRPLAY_IPATOOL_PLATFORM=iphone
# FAIRPLAY_IPATOOL_RETRIES=3
# FAIRPLAY_IPATOOL_TIMEOUT_MS=2700000
# Optional storefront override for ipatool --country (also settable in the iOS FairPlay screen):
# FAIRPLAY_IPATOOL_STOREFRONT=us
# FAIRPLAY_IPATOOL_COUNTRY_FLAG=1
# Prefetch encrypted IPAs in the background (0 to disable):
# MAC_IPATOOL_PREFETCH=1
# MAC_IPATOOL_PREFETCH_MS=45000

# Own Telegram decrypt bot (@BotFather) — optional but recommended on the Mac host.
# Never commit a real token. If it was pasted in chat/screenshots, revoke it in @BotFather
# (/revoke) and put the new one only in ~/.tetherless-mac.env on the Mac.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Telegram bot @FastDecryptAI (fastdecrypt.ai — Cursor AI naming); site is fastdecrypt.bot:
# TELEGRAM_BOT_USERNAME=FastDecryptAI
# TELEGRAM_BOT_BRAND=FastDecrypt
#
# Discord bot (FastDecrypt) — Discord Developer Portal → Bot → Reset Token.
# Never commit the token. Rename the application to FastDecrypt. Enable
# MESSAGE CONTENT INTENT. Invite with bot + applications.commands.
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_NAME=FastDecrypt
# DISCORD_UPLOAD_MAX_MB=24
# After enabling Message Content Intent in the Discord portal:
# DISCORD_MESSAGE_CONTENT=1
# Discord VIP / limits / admin (/users):
# DISCORD_VIP_IDS=123456789012345678
# DISCORD_ADMIN_IDS=123456789012345678
# DISCORD_FREE_DAILY=5
# DISCORD_VIP_DAILY=100
# FASTDECRYPT_VIP_URL=https://fastdecrypt.bot/vip
# VIP seller @username (shown by /vip) — your personal handle, not the bot:
# TELEGRAM_VIP_CONTACT=YourTelegramUsername
# Optional: comma-separated Telegram user ids that already have VIP:
# TELEGRAM_VIP_IDS=
# Bot is public by default (anyone who messages). To lock it down:
# TELEGRAM_LOCKDOWN=1
# TELEGRAM_ALLOWED_IDS=123456789
#
# Standalone Tetherless bot — WebSSH (no desktop):
#   zsh ~/tetherless/server/mac-ssh.sh start
#   zsh ~/tetherless/server/mac-ssh.sh status
#   zsh ~/tetherless/server/mac-ssh.sh logs
# TestFlight: drop encrypted IPAs in ~/tetherless-drop then: decrypt App.ipa
# MAC_TG_DROP_DIR=$HOME/tetherless-drop
#
# Dedicated Keychain (avoids broken login.keychain password prompts):
# TETHERLESS_KEYCHAIN_PASSWORD=pick-a-strong-pass
# Then once: zsh ~/tetherless/server/mac-ssh.sh login
# (finds ipatool even when SSH PATH is bare; or set FAIRPLAY_IPATOOL_BIN=/full/path)
#
# Full HTTPS Mac API for the iOS app (FairPlay Decrypt → Mac API URL):
# MAC_API_OPEN=1
# MAC_API_PORT=8787
# WebSSH: zsh ~/tetherless/server/mac-ssh.sh api
# Defaults MAC_PUBLIC_BASE to https://fastdecrypt.bot (no cloudflared).
# Point fastdecrypt.bot DNS / reverse-proxy → this Mac :8787 for /d/ and /open/.
# Optional ephemeral tunnel only if needed:
# MAC_USE_CLOUDFLARED=1
# Public base for IPA download + Open-in links (bot stages /d/<token>):
# MAC_PUBLIC_BASE=https://fastdecrypt.bot
# Web decrypt UI: https://fastdecrypt.bot/  and /decrypt (max IPA size for download):
# MAC_WEB_MAX_GB=6
# MAC_TG_PUBLIC_DL_TTL_MIN=120
# MAC_TG_MIN_FREE_DISK_GB=8
#
# Caddy: use server/Caddyfile.fastdecrypt.example (no gzip on /d/*; flush streaming).
#   cp ~/tetherless/server/Caddyfile.fastdecrypt.example ~/tetherless-run/Caddyfile
#   sudo caddy reload --config ~/tetherless-run/Caddyfile
# Parallel decrypt workers (omit to auto: 2 on ≤16 GB Macs):
# MAC_TG_WORKERS=2
#
# Premium *user* session — large IPAs (≤4 GB) via YOUR Premium account.
# If TELEGRAM_SESSION is missing, log in once (phone + code). Optional invite
# wires the secret staging channel in the same step:
#   zsh ~/tetherless/server/mac-ssh.sh session 'https://t.me/+YOUR_INVITE'
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
# TELEGRAM_PREMIUM_UPLOAD=1
#
# Secret staging channel (required for big IPAs to arbitrary users).
# If session already exists:
#   zsh ~/tetherless/server/mac-ssh.sh channel 'https://t.me/+YOUR_INVITE'
# Then add @FastDecryptAI as admin (Post messages).
# TELEGRAM_UPLOAD_CHANNEL=-100xxxxxxxxxx
# TELEGRAM_UPLOAD_CHANNEL_KEEP=0
#
# Optional local Bot API ≤2000 MB (if you skip Premium session):
#   TELEGRAM_API_ROOT=http://127.0.0.1:8081
#   TELEGRAM_LOCAL_API=1
#
# Cloud cache (instant re-send): after first decrypt, Telegram file_id is stored under
# ~/tetherless-ipa-cache. Same App Store link later → send by file_id (no re-decrypt).
# MAC_TG_IPA_CACHE_DIR=$HOME/tetherless-ipa-cache
# Encrypted App Store IPAs (skip ipatool re-download on version rematch):
# MAC_TG_ENC_CACHE_DIR=$HOME/tetherless-ipa-cache/encrypted
#
# Parallel decrypt workers (default 3). Excess jobs queue instead of "Busy".
# MAC_TG_WORKERS=3
#
# App Store URL history (pasted links are deleted from chat; /history re-decrypts):
# MAC_TG_URL_LOG_DIR=$HOME/tetherless-url-log
# MAC_TG_URL_LOG_MAX=40
#
# Per-user usage log (telegram id + @username on every message/callback):
# MAC_TG_USER_LOG_DIR=$HOME/tetherless-user-log
# MAC_TG_USER_LOG_DAYS=30
#
# App name search countries (comma list; first hits win):
# MAC_TG_SEARCH_COUNTRIES=us,hk,jp,de,fr,au,ca,cn,pl,vn,ru
#
# Progress banners use sharp (npm install in server/). mac-ssh.sh start installs it.
#
# Result buttons on the IPA (✨ Patch Help · ⭐ Get VIP).
# FastDecrypt defaults: https://fastdecrypt.bot + /vip (override with FASTDECRYPT_*):
# FASTDECRYPT_SITE_URL=https://fastdecrypt.bot
# FASTDECRYPT_PATCH_URL=https://fastdecrypt.bot/
# FASTDECRYPT_VIP_URL=https://fastdecrypt.bot/vip
# Legacy DELvEK aliases still work:
# DELVEK_SITE_URL=https://delvek.net
# DELVEK_PATCH_URL=https://delvek.net/
# DELVEK_VIP_URL=

